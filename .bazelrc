build --cxxopt=-std=c++23
build --repo_env=CC=cc
build --repo_env=CXX=c++
# Use libstdc++ by default since it's more widely available, but allow switching to libc++ with --config=libcxx
build --config=libstdcxx

# Force use of GCC (with libstdc++)
build:gcc --repo_env=CC=gcc --repo_env=CXX=g++ --config=libstdcxx
# Force use of Clang (with libc++)
build:clang --repo_env=CC=clang --repo_env=CXX=clang++ --config=libcxx

# Force a particular standard library
build:libcxx --cxxopt=-stdlib=libc++ --cxxopt=-Wno-unused-command-line-argument --linkopt=-lc++
build:libstdcxx --cxxopt=-D_GLIBCXX_USE_CXX11_ABI=1  # gcc/libstdc++ default

build --incompatible_enable_cc_toolchain_resolution=false
build --check_direct_dependencies=off

# Custom module rules use the compiler directly with -fmodule-file flags that embed absolute paths,
# which are incompatible with sandboxing. Use local strategy for module compilation actions.
build --strategy=Genrule=local
build --strategy=CppModulePrecompile=local
build --strategy=CppModuleCompileObj=local
build --strategy=CppModuleCompileSrc=local
build --strategy=CppModuleCompile=local
build --strategy=CppModuleArchive=local
build --strategy=CppStdModulePrecompile=local
build --strategy=CppStdModuleCompileObj=local
build --strategy=CppStdModuleCompile=local
build --strategy=CppModuleCompilePcm=local
