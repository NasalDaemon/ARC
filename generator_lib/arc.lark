%import common.CNAME -> NAME

%import common.SIGNED_NUMBER
%import common.ESCAPED_STRING -> STRING
%import common.WS
%import common.C_COMMENT
%import common.CPP_COMMENT

%ignore WS
%ignore C_COMMENT
%ignore CPP_COMMENT

include: INCLUDE_LOCAL_FILE
       | INCLUDE_GLOBAL_FILE
INCLUDE_LOCAL_FILE: "#include \"" /[^\r\n"]+/ "\""
INCLUDE_GLOBAL_FILE: "#include <" /[^\r\n>]+/ ">"

namespace: "namespace" NAMESPACE "{" (scope)+ "}"

scope: [template_params] CLUSTER  cluster_scope  -> cluster
     | [template_params] DOMAIN   cluster_scope  -> domain
     | [template_params] TRAIT    trait_scope    -> trait
     |                   PROTOCOL protocol_scope -> protocol
     |                   POLICY   policy_scope   -> policy

CLUSTER:  "cluster"
DOMAIN:   "domain"
TRAIT:    "trait"
PROTOCOL: "protocol"
POLICY:   "policy"

protocol_scope: FQNAME "{" protocol_body+ "}"

?protocol_body: proto_state_def
              | proto_per_def
              | NAME cpp_func_params INVARIANT invariant_target -> proto_pred_with_params
              | NAME                 INVARIANT invariant_target -> proto_pred
              | proto_state_trans                              -> proto_state_trans_top

?per_body: proto_state_def
         | NAME cpp_func_params INVARIANT invariant_target -> proto_pred_with_params
         | NAME                 INVARIANT invariant_target -> proto_pred
         | proto_state_trans                              -> proto_state_trans_top

proto_state_def: STATE NAME "{" (proto_state_trans | proto_variant_invariant)+ "}"
proto_per_def:   PER  cpp_func_params "{" per_body+ "}"

proto_variant_invariant: NAME INVARIANT invariant_target

invariant_target: "(" bracket_content ")" -> invariant_expr
                | proto_bare_ref           -> invariant_bare_ref

STATE.2:    "state"
PER.2:      "per"
INVARIANT.2: "implies" | "iff"

proto_state_trans: proto_state_set (proto_state_arrow proto_state_set)+

proto_state_arrow: R_RARROW  -> state_arrow_r
                 | B_RARROW  -> state_arrow_b
                 | L_RARROW  -> state_arrow_l

proto_state_set: NAME ("|" NAME)*

cluster_scope:  FQNAME [cluster_annotations] "{" node+ connection_block* "}"
policy_scope:   FQNAME                       "{" group_alias* group_connection+ "}"
trait_scope:    FQNAME [trait_annotations]   "{" trait_body+ "}" -> trait_def
           |    FQNAME "=" trait_alias_rhs ("+" trait_alias_rhs)* -> trait_alias

trait_alias_rhs: FQNAME [full_templ_args]

group_alias: group_name "=" cpp_type_no_typename

group_connection: group_names (group_arrow group_names)+

group_name: GROUP_DEFAULT | GROUP_ANY | NAME
group_names: group_name ("," group_name)*

GROUP_DEFAULT: "@nogroup" | "~"
GROUP_ANY: "@any" | "*"

L_RARROW:  "<" "-"+
R_RARROW:      "-"+ ">"
L_WARROW:  "<" "="+
R_WARROW:      "="+ ">"
B_RARROW:  "<" "-"+          ">"
B_WARROW:  "<" "="+          ">"
B_WRARROW: "<" "="+ "|" "-"+ ">"
B_RWARROW: "<" "-"+ "|" "="+ ">"

group_arrow: L_RARROW  -> group_l_r_arrow
           | L_WARROW  -> group_l_w_arrow
           | R_RARROW  -> group_r_r_arrow
           | R_WARROW  -> group_r_w_arrow
           | B_RARROW  -> group_bi_rr_arrow
           | B_WARROW  -> group_bi_ww_arrow
           | B_WRARROW -> group_bi_wr_arrow
           | B_RWARROW -> group_bi_rw_arrow

cluster_annotations: "[" cluster_annotation ["," cluster_annotation] "]"
cluster_annotation: [NAME "="] CLUSTER_ANNOTATION_NAME
                  | CLUSTER_TRUNK_ANNOTATION "=" trunk_trait ("+" trunk_trait)*
trunk_trait: FQNAME [full_templ_args]
CLUSTER_ANNOTATION_NAME.1: "Context" | "Root" | "Info"
CLUSTER_TRUNK_ANNOTATION.2: "Trunk"

trait_annotations: "[" trait_annotation_item ("," trait_annotation_item)* "]"
?trait_annotation_item: trait_annotation | trait_protocol_annotation
trait_annotation: [NAME "="] TRAIT_ANNOTATION_NAME
trait_protocol_annotation: "Protocol" "=" FQNAME
TRAIT_ANNOTATION_NAME.1: "Types" | "Root" | "Info" | "Impl"

trait_body: trait_type | trait_root | trait_info | trait_requires | trait_method

trait_type: "type" NAMESPACE
trait_root: "root" NAMESPACE
trait_info: "info" NAMESPACE

trait_requires: trait_requires_inline
              | trait_requires_block

trait_requires_inline: "requires" cpp_requires_statement

# TODO: Multiple statements (parser fails with ambiguity atm)
trait_requires_block: "requires" [cpp_func_params] "{" cpp_requires_statement "}"

!cpp_requires_statement: cpp_expr [SEMICOLON]
                       | "{" cpp_expr "}" ["->" cpp_type] [SEMICOLON]

trait_method: NAME "(...)" -> trait_method_elipsis
            | [template_params] method_name cpp_func_params [method_qualifier] ["->" cpp_type] method_contract* [method_default_impl] -> trait_method_signature

method_default_impl: "{" bracket_content "}"

?method_contract: pre_contract | post_contract | is_clause | if_clause | to_clause

pre_contract:  "pre"  "(" bracket_content ")"
post_contract: "post" "(" bracket_content ")"

is_clause: "is" proto_clause_body ["then" proto_clause_body]
if_clause: "if" proto_clause_body  "then" proto_clause_body
to_clause: "to" proto_clause_body

proto_clause_body: "(" bracket_content ")" -> clause_paren
                 | proto_bare_ref
proto_bare_ref: NAME ["(" bracket_content ")"]

# Bracket-symmetric C++ expression content.
# Accepts any sequence of non-bracket tokens and recursively balanced () [] {}.
# Angle brackets are not tracked: they are indistinguishable from comparison
# operators and template delimiters in a context-free grammar. The C++ compiler
# validates the expression text once it is embedded in the generated code.
bracket_content: bracket_item*
!bracket_item: BRACKET_ATOM
             | "(" bracket_content ")"
             | "[" bracket_content "]"
             | "{" bracket_content "}"
BRACKET_ATOM: /[^()\[\]{}`]+/ | /`[^`]*`/

# Full bracket-symmetric content including angle brackets.
# Used in positions where < and > are unambiguously template delimiters
# (not comparison operators). Bare < or > that are NOT template delimiters
# (e.g. comparison operators in non-type template value arguments) must be
# escaped by surrounding them with backticks, e.g. `<` or `N >= 0`.
# Backticks are stripped from the reconstructed C++ output.
full_bracket_content: full_bracket_item*
!full_bracket_item: FULL_BRACKET_ATOM
             | "(" full_bracket_content ")"
             | "[" full_bracket_content "]"
             | "{" full_bracket_content "}"
             | "<" full_bracket_content ">"
FULL_BRACKET_ATOM: /[^()\[\]{}<>`]+/ | /`[^`]*`/

!full_templ_args: "<" full_bracket_content ">"

method_name: (OPTIONAL_METHOD | NORMAL_METHOD)* NAME
method_qualifier: "const"

OPTIONAL_METHOD: "?"
NORMAL_METHOD: "!"

template_params: "template" "<" template_param ("," template_param)* ">"

template_param: TPARAM_TYPE    NAME -> tparam_type_pack
              | cpp_tmpl_param NAME -> tparam_non_type

TPARAM_TYPE: (TYPENAME | "class") ["..."]

node: NAME "=" node_type (":" node_type_wrapper)*

node_type: [TYPENAME] node_type_wrapper
node_type_wrapper: NAMESPACE [cpp_templ_args]

connection_block: connection_aliases* connection_trait (connection+ | sink_node)

connection_aliases: "using" connection_alias ("," connection_alias)*

connection_alias: NAME "=" cpp_type

connection_trait: "[" connection_trait_type [BARROW connection_trait_type] "]" -> connection_trait_normal
                | "[[" connection_trait_type ("+" connection_trait_type)* [BARROW connection_trait_type] "]]" -> connection_trait_trunk

connection_trait_type: SPECIAL_TRAIT | cpp_type

NO_TRAIT: "~" | "@notrait"
GLOBAL_TRAIT: "^" | "@global"
SPECIAL_TRAIT: NO_TRAIT | GLOBAL_TRAIT

connection: node_names (arrow node_names)+

sink_node: node_names                    -> sink_node_implicit
         | node_names LARROW ALL_NODES   -> sink_node_larrow
         | ALL_NODES  RARROW node_names  -> sink_node_rarrow

ALL_NODES: "*" | "@all"

arrow:             LARROW             -> left_arrow
     |             RARROW             -> right_arrow
     |             BARROW             -> bi_arrow
     |             LARROW arrow_trait -> left_arrow_from
     | arrow_trait RARROW             -> right_arrow_from
     | arrow_trait LARROW             -> left_arrow_to
     |             RARROW arrow_trait -> right_arrow_to
     | arrow_trait LARROW arrow_trait -> left_arrow_both
     | arrow_trait RARROW arrow_trait -> right_arrow_both

arrow_trait: "(" cpp_type ")"

LARROW: "<"+ ("-"|"=")+
RARROW:      ("-"|"=")+ ">"+
BARROW: "<"+ ("-"|"=")+ ">"+

!cpp_type: [TYPENAME] (NAME | "::" cpp_type_no_typename) cpp_type_cont*
!cpp_type_no_typename: (NAME | "::" cpp_type_no_typename) cpp_type_cont*

!cpp_type_cont: CPP_REF | "const" | "volatile" | "auto" | "decltype" | "..."
              | "::" [TEMPLATE] cpp_type_no_typename
              | cpp_func_args
              | cpp_templ_args

!cpp_tmpl_param: [TEMPLATE "<" cpp_tmpl_param ("," cpp_tmpl_param)* ">"] cpp_type_no_typename

cpp_func_params: "(" [cpp_func_param ("," cpp_func_param)*] ")"
cpp_func_param: cpp_type NAME

!cpp_func_args:  "(" [full_bracket_content] ")"
!cpp_templ_args: "<" [full_bracket_content] ">"


!cpp_expr: CPP_LITERALS | cpp_expr_complex

!cpp_expr_complex: CPP_UNARY_OP* cpp_type cpp_expr_complex_cont*

!cpp_expr_complex_cont: CPP_BINARY_OP cpp_expr
                      | CPP_MEM_ACCESS cpp_expr_mem_access
                      | "{" [cpp_expr ("," cpp_expr)*] "}"
                      | "[" [cpp_expr ("," cpp_expr)*] "]"

!cpp_expr_mem_access: [TEMPLATE] cpp_type_no_typename cpp_expr_complex_cont*
                    | "operator" (CPP_BINARY_OP | ("()"|"[]") [cpp_templ_args]) cpp_func_args

node_name: NODE_SPECIAL | NAME
node_names: "{" node_name ("," node_name)+ "}" -> node_names_fanout
          |     node_name ("," node_name)*     -> node_names_list

PARENT_NODE: ".." | "@parent"
GLOBAL_NODE: "^" | "@global"
NODE_SPECIAL: PARENT_NODE | GLOBAL_NODE
NAMESPACE: NAME ("::" NAME)*
FQNAME: ["::"] NAMESPACE+

CPP_REF: "*"+ | "&"+
CPP_MEM_ACCESS: "." | "->"
CPP_UNARY_OP: "*" | "&" | "!" | "not" | "+" | "-"
CPP_BINARY_OP: "+" | "-" | "/" | "*" | "%" | "|" | "&" | "||" | "&&" | "or" | "and" | "==" | "!=" | ">=" | "<=" | "<=>" | ".*" | "->*"

TYPENAME: "typename"
TEMPLATE: "template"
SEMICOLON: ";"

CPP_LITERALS: SIGNED_NUMBER | STRING | CHAR
CHAR: "'" /\\?./ "'"
