}
{% endfor %}
{% for policy in namespace.policies %}
{% for classification in policy.groups %}

struct policy::{{ policy.name }}::{{ classification.name }} : ::arc::Group
{
    using ::arc::Group::connectionsTo;
    using ::arc::Group::connectionsFrom;

    {% for toName, write in classification.connectionsTo %}
    static auto connectionsTo({{ toName }} const*) -> {{ "::arc::GroupWriteAccess" if write else "void" }};
    {% endfor %}
    {% for fromName, write in classification.connectionsFrom %}
    static auto connectionsFrom({{ fromName }} const*) -> {{ "::arc::GroupWriteAccess" if write else "void" }};
    {% endfor %}
};
{% endfor %}
{% endfor %}
{% for trait in namespace.traits %}

{{ export }}{{ trait.wrapping_namespace }} {
{% if trait.templates %}
{{ template(trait.templates) }}
{% endif %}
struct {{ trait.name }} : ::arc::Trait
{
    {% for method_name in trait.method_names %}
    ARC_METHOD_TAG({{ method_name }})
    {% endfor %}

    template<::arc::IsMethodOf<{{ trait.name }}> Tag>
    friend constexpr {{ trait.name }} traitOf(Tag) { return {}; }

    struct Meta
    {
        using ARC_This_Trait = {{ trait.name }};
        {% if trait.has_protocol %}
        using Protocol = {{ trait.protocol_name }};
        {% endif %}
        // List of method tags
        struct MethodTags
        {
            {% for method_name in trait.method_names %}
            ARC_METHOD_TAG_ALIAS({{ method_name }})
            {% endfor %}
        };
        // Queryable list of methods applicable to this trait
        struct Applicable
        {
            {% for method_name in trait.method_names %}
            ARC_METHOD_TAG_APPLICABLE({{ method_name }})
            {% endfor %}
        };
        {% if trait.is_protocol %}
        struct States
        {
            {% for group in trait.state_groups %}
            enum class {{ group.name }}
            {
                {% for variant in group.variants %}
                {{ variant }},
                {% endfor %}
            };
            friend constexpr std::string_view toString({{ group.name }} e)
            {
                switch (e)
                {
                {% for var in group.variants %}
                case {{ group.name }}::{{ var }}: return "{{ var }}";
                {% endfor %}
                }
                return "<Unknown>";
            }
            friend constexpr bool isValidTransition({{ group.name }} from, {{ group.name }} to)
            {
                if (from == to) return true;
                {% if group.has_edges %}
                switch (from)
                {
                {% for from_var, to_set in group.adjacency().items() %}
                case {{ group.name }}::{{ from_var }}:
                    return {% for v in to_set | sort %}to == {{ group.name }}::{{ v }}{% if not loop.last %} || {% endif %}{% endfor %};
                {% endfor %}
                default: return false;
                }
                {% endif %}
                return false;
            }
            {% endfor %}
        };
        struct StateTransitionLog
        {
            {% for group in trait.state_groups %}
            {% if group.params %}
            std::vector<::arc::ProtocolStateLog<ARC_This_Trait::Meta::States::{{ group.name }}{% for type, name in group.params %}, {{ type }}{{ type.pack }}{% endfor %}>> {{ decapitalise(group.name) }}{};
            {% else %}
            std::optional<ARC_This_Trait::Meta::States::{{ group.name }}> {{ decapitalise(group.name) }}Entry{}, {{ decapitalise(group.name) }}Exit{};
            {% endif %}
            {% endfor %}

            {% if trait.variant_invariants %}
            template<class Assert, class Self, class ProtoView>
            static constexpr void checkInvariants(Assert& _arc_assert_, Self const& self, ProtoView const& proto, [[maybe_unused]] StateTransitionLog const& log)
            {
                ARC_IF_GCC(::arc::ignoreArgs(log));
                {% set src_groups = trait.variant_invariants | groupby('source_group') %}
                {% for group_name, group_invs in src_groups %}
                {% set src = group_invs[0].source_group_ref %}
                {% if src.params %}
                for (auto const& _arc_e_ : log.{{ decapitalise(group_name) }})
                {
                    std::apply([&]({% for type, name in src.params %}{{ type }}{{ type.pack }} const& {{ name }}{{ type.pack }}{% if not loop.last %}, {% endif %}{% endfor %}) {
                        {% for inv in group_invs %}
                        {
                            bool _arc_src_ = proto.{{ inv.source_variant }}({% for _t, pn in src.params %}{{ pn }}{% if not loop.last %}, {% endif %}{% endfor %});
                            bool _arc_tgt_ = static_cast<bool>({{ inv.target_expr }});
                            {% if inv.kind == 'iff' %}
                            _arc_assert_(self, ARC_ASSERT_ARGS("{{ inv.pos }} iff", _arc_src_ == _arc_tgt_));
                            {% else %}
                            _arc_assert_(self, ARC_ASSERT_ARGS("{{ inv.pos }} implies", !_arc_src_ || _arc_tgt_));
                            {% endif %}
                        }
                        {% endfor %}
                    }, _arc_e_.key);
                }
                {% else %}
                {
                    {% for inv in group_invs %}
                    {
                        bool _arc_src_ = proto.{{ inv.source_variant }}();
                        bool _arc_tgt_ = static_cast<bool>({{ inv.target_expr }});
                        {% if inv.kind == 'iff' %}
                        _arc_assert_(self, ARC_ASSERT_ARGS("{{ inv.pos }} iff", _arc_src_ == _arc_tgt_));
                        {% else %}
                        _arc_assert_(self, ARC_ASSERT_ARGS("{{ inv.pos }} implies", !_arc_src_ || _arc_tgt_));
                        {% endif %}
                    }
                    {% endfor %}
                }
                {% endif %}
                {% endfor %}
                {% for tgt_group_name, group_invs in trait.variant_invariants | selectattr('has_target_group') | groupby('target_group') %}
                {% if tgt_group_name not in src_groups %}
                {% set tgt_grp = group_invs[0].target_group_ref %}
                {% if tgt_grp.params %}
                for (auto const& _arc_e_ : log.{{ decapitalise(tgt_group_name) }})
                {
                    if (std::ranges::find_if(log.{{ decapitalise(group_invs[0].source_group) }}, [&](auto const& _arc_s_) { return _arc_s_.key == _arc_e_.key; }) == log.{{ decapitalise(group_invs[0].source_group) }}.end())
                    {
                        std::apply([&]({% for type, name in tgt_grp.params %}{{ type }}{{ type.pack }} const& {{ name }}{{ type.pack }}{% if not loop.last %}, {% endif %}{% endfor %}) {
                            {% for inv in group_invs %}
                            {
                                bool _arc_src_ = proto.{{ inv.source_variant }}({% for _t, pn in tgt_grp.params %}{{ pn }}{% if not loop.last %}, {% endif %}{% endfor %});
                                bool _arc_tgt_ = static_cast<bool>({{ inv.target_expr }});
                                _arc_assert_(self, ARC_ASSERT_ARGS("{{ inv.pos }} iff", _arc_src_ == _arc_tgt_));
                            }
                            {% endfor %}
                        }, _arc_e_.key);
                    }
                }
                {% endif %}
                {% endif %}
                {% endfor %}
            }
            {% else %}
            ARC_INLINE static constexpr void checkInvariants(auto&&...) {}
            {% endif %}

            template<class Assert, class Self, class ProtoReal>
            static constexpr void checkTransitions(Assert& _arc_assert_, Self const& self, ProtoReal const& real, StateTransitionLog const& log)
            {
                {% for group in trait.state_groups %}
                {% if group.params %}
                for (auto const& e : log.{{ decapitalise(group.name) }})
                {
                    std::apply([&](auto const&... k) {
                        ::arc::checkTransition(
                            _arc_assert_, self, e.entry, e.exit,
                            "ARC protocol transition violation: {{ group.name }}",
                            "ARC unannounced transition: {{ group.name }}",
                            real,
                            proto{{ group.name }}_c,
                            k...
                        );
                    }, e.key);
                }
                {% else %}
                if (log.{{ decapitalise(group.name) }}Entry.has_value())
                {
                    ::arc::checkTransition(
                        _arc_assert_, self, *log.{{ decapitalise(group.name) }}Entry, log.{{ decapitalise(group.name) }}Exit,
                        "ARC protocol transition violation: {{ group.name }}",
                        "ARC unannounced transition: {{ group.name }}",
                        real,
                        proto{{ group.name }}_c
                    );
                }
                {% endif %}
                {% endfor %}
            }
        };
        {% endif %}
        // Contracts and return type constraints of method signatures
        struct Constraints
        {
            {% if trait.has_protocol and trait.methods | selectattr("has_contracts", "eq", False) | list %}
            struct ProtoOnly : ::arc::NoConstraints
            {
                using ProtoSnap = ::arc::ProtoSnap<ARC_This_Trait, 0>;
                static constexpr auto preProto(auto& _arc_assert_, auto self, auto const&...) -> ProtoSnap
                {
                    static_assert(_arc_assert_.enabled);
                    ProtoSnap snap{};
                    ARC_This_Trait::Meta::Protocol::Meta::RecordingView proto(self.asTrait(::arc::protocol<ARC_This_Trait>()), snap.log);
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkInvariants(_arc_assert_, self, proto, snap.log);
                    return snap;
                }
                static constexpr void postProto(auto& _arc_assert_, auto self, auto const&, auto& _arc_snap_)
                {
                    static_assert(_arc_assert_.enabled);
                    ARC_This_Trait::Meta::Protocol::Meta::PostRecordingView proto(self.asTrait(::arc::protocol<ARC_This_Trait>()), _arc_snap_.log);
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkTransitions(_arc_assert_, self, self.asTrait(::arc::protocol<ARC_This_Trait>()), _arc_snap_.log);
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkInvariants(_arc_assert_, self, proto, _arc_snap_.log);
                }
            };
            {% endif %}
            {% for method in trait.methods %}
            {% if method.has_contracts or (method.return_type.is_auto and method.return_type.str != "decltype(auto)") %}
            struct {{ capitalise(method.name) }}{{ loop.index }} : ::arc::NoConstraints
            {
                {% if method.return_type.is_auto and method.return_type.str != "decltype(auto)" %}
                template<class T, class {{ trait.types_name or "" }}>
                static consteval {{ method.return_type.str }} Return() { return ARC_DECLVAL(T); }
                static constexpr bool DecltypeAuto = {{ cppbool(method.return_type.str.endswith("decltype(auto)")) }};
                {% endif %}
                {% if trait.has_protocol or method.has_proto_contracts %}
                {% if trait.has_protocol %}
                template<class... Args>
                using ProtoSnap = ::arc::ProtoSnap<ARC_This_Trait, {{ method.proto_if_exprs | length }}, Args...>;
                {% else %}
                template<class... Args>
                using ProtoSnap = ::arc::ProtoSnap<ARC_This_Trait, {{ method.proto_if_exprs | length }}, Args...>;
                {% endif %}
                static constexpr auto preProto(auto& _arc_assert_, auto self
                    {%- for type, name in method.params -%}
                    , [[maybe_unused]] auto const& {{ name }}{{ type.pack }}
                    {%- endfor -%}
                )
                    -> ProtoSnap<{%- for type, name in method.params -%}std::decay_t<decltype({{ name }})>{{ type.pack }}{%- if not loop.last -%}, {% endif -%}{%- endfor -%}>
                {
                    static_assert(_arc_assert_.enabled);
                    ARC_IF_GCC(::arc::ignoreArgs(
                    {%- set comma = joiner(", ") -%}
                    {%- for type, name in method.params -%}
                    {{ comma() }}{{ name }}
                    {%- endfor -%}
                    ));
                    ::arc::StateTransitionLog<ARC_This_Trait> log{};
                    {% if trait.has_protocol %}
                    ARC_This_Trait::Meta::Protocol::Meta::RecordingView proto(self.asTrait(::arc::protocol<ARC_This_Trait>()), log);
                    {% else %}
                    ARC_This_Trait::Meta::RecordingView proto(self, log);
                    {% endif %}
                    {% for pos, expr in method.proto_pre_exprs %}
                    _arc_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ expr }}));
                    {% endfor %}
                    {% for pos, name, cond, then in method.proto_if_exprs %}
                    bool if_{{ loop.index0 }} = static_cast<bool>({{ cond }});
                    {% endfor %}
                    {% for call in method.proto_snap_calls(False) %}
                    (void)({{ call }});
                    {% endfor %}
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkInvariants(_arc_assert_, self, proto, log);
                    return {std::make_tuple({%- for type, name in method.params -%}{{ name }}{{ type.pack }}{{ ", " if not loop.last else "" }}{%- endfor -%}), {
                        {%- for pos, name, cond, then in method.proto_if_exprs -%}
                        if_{{ loop.index0 }},
                        {%- endfor -%}
                        }, std::move(log)};
                }
                static constexpr void postProto(auto& _arc_assert_, auto self, [[maybe_unused]] auto const& _arc_post_return_contract_value_, auto& _arc_snap_)
                {
                    ARC_IF_GCC(::arc::ignoreArgs(_arc_post_return_contract_value_));
                    static_assert(_arc_assert_.enabled);
                    {% if method.params %}
                    [[maybe_unused]] auto const& [{% for type, name in method.params %}{{ name }}{{ type.pack }}{{ ", " if not loop.last else "" }}{% endfor %}] = (_arc_snap_.args);
                    {% endif %}
                    {% if trait.has_protocol %}
                    [[maybe_unused]] ARC_This_Trait::Meta::Protocol::Meta::PostRecordingView proto(self.asTrait(::arc::protocol<ARC_This_Trait>()), _arc_snap_.log);
                    {% else %}
                    [[maybe_unused]] ARC_This_Trait::Meta::PostRecordingView proto(self, _arc_snap_.log);
                    {% endif %}
                    {% if method.implies %}
                    {% if method.implies.kind == 'iff' %}
                    _arc_assert_(self, ARC_ASSERT_ARGS("{{ method.implies.assert_msg }}",
                        _arc_post_return_contract_value_ == static_cast<bool>({{ method.implies.expr }})
                    ));
                    {% else %}
                    _arc_assert_(self, ARC_ASSERT_ARGS("{{ method.implies.assert_msg }}",
                        !_arc_post_return_contract_value_ || static_cast<bool>({{ method.implies.expr }})
                    ));
                    {% endif %}
                    {% endif %}
                    {% for pos, name, expr in method.proto_post_exprs %}
                    {
                        {% if name != "_" %}
                        [[maybe_unused]] auto const& {{ name }} = _arc_post_return_contract_value_;
                        {% endif %}
                        _arc_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ expr }}));
                    }
                    {% endfor %}
                    {% for pos, name, cond, then in method.proto_if_exprs %}
                    {
                        {% if name != "_" %}
                        [[maybe_unused]] auto const& {{ name }} = _arc_post_return_contract_value_;
                        {% endif %}
                        _arc_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", !_arc_snap_.ifs[{{ loop.index0 }}] || ({{ then }})));
                    }
                    {% endfor %}
                    {% if trait.has_protocol %}
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkTransitions(_arc_assert_, self, self.asTrait(::arc::protocol<ARC_This_Trait>()), _arc_snap_.log);
                    {% else %}
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkTransitions(_arc_assert_, self, self, _arc_snap_.log);
                    {% endif %}
                    ::arc::StateTransitionLog<ARC_This_Trait>::checkInvariants(_arc_assert_, self, proto, _arc_snap_.log);
                }
                {% endif %}
                {% if method.pre_exprs %}
                static constexpr void pre(auto& _arc_contract_assert_, auto self
                    {%- for type, name in method.params -%}
                    , [[maybe_unused]] auto const&{{ type.pack }} {{ name }}
                    {%- endfor -%}
                )
                {
                    static_assert(_arc_contract_assert_.enabled);
                    ARC_IF_GCC(::arc::ignoreArgs(
                    {%- set comma = joiner(", ") -%}
                    {%- for type, name in method.params -%}
                    {{ comma() }}{{ name }}
                    {%- endfor -%}
                    ));
                    {% for pos, pre in method.pre_exprs %}
                    _arc_contract_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ pre }}));
                    {% endfor %}
                }
                {% endif %}
                {% if method.post_exprs %}
                static constexpr void post(auto& _arc_contract_assert_, auto self, [[maybe_unused]] auto const& _arc_post_return_contract_value_)
                {
                    ARC_IF_GCC(::arc::ignoreArgs(_arc_post_return_contract_value_));
                    static_assert(_arc_contract_assert_.enabled);
                    {% for pos, name, expr in method.post_exprs %}
                    {
                        {% if name != "_" %}
                        auto const& {{ name }} = _arc_post_return_contract_value_;
                        {% endif %}
                        _arc_contract_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ expr }}));
                    }
                    {% endfor %}
                }
                {% endif %}
            };
            {% elif trait.has_protocol %}
            using {{ capitalise(method.name) }}{{ loop.index }} = ProtoOnly;
            {% else %}
            using {{ capitalise(method.name) }}{{ loop.index }} = ::arc::NoConstraints;
            {% endif %}
            {% endfor %}
        };
        // Method signatures generated for this trait
        struct Signatures
        {
            {% for method in trait.methods %}
            {{ method_template_params(trait, method) }}
            static auto {{ method.name }}(Self{{ " const&" if method.is_const else "&" }}
                {%- for type, name in method.params -%}
                , {{ type }}{{ type.pack }} {{ name }}
                {%- endfor -%}
            )
            {% if method.return_type.is_auto %}
            {% if method.return_type.str == "decltype(auto)" %}
                -> ::arc::InvokeMethod<{ {{ cppbool(method.is_const) }}, {{ cppbool(method.default_impl is not none) }}}, typename ARC_This_Trait::Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}{{ argdecltypes(method) }}>;
            {% else %}
                -> ::arc::InvokeMethodC<{ {{ cppbool(method.is_const) }}, {{ cppbool(method.default_impl is not none) }}}, typename ARC_This_Trait::Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}{{ argdecltypes(method) }}>;
            {% endif %}
            {% else %}
                -> ::arc::InvokeMethodR<{ {{ cppbool(method.is_const) }}, {{ cppbool(method.default_impl is not none) }}}, typename ARC_This_Trait::Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}, ARC_TYPENAME({{ method.return_type.str }}){{ argdecltypes(method) }}>;
            {% endif %}
            {% endfor %}
        };
        // Query method signature by tag `SignaturesByTag::impl(method, ...)` --> `Signatures::method(...)`
        struct SignaturesByTag
        {
            {% for method_name in trait.method_names %}
            ARC_SIGNATURE_METHOD_TAG({{ method_name }})
            {% endfor %}
        };
        // Provides interface to TraitView, enforcing Meta::Signatures and Meta::Constraints
        struct NamedMethods
        {
            struct {{ trait.name }} : ::arc::MethodsBase
            {
                {% for method_name in trait.method_names %}
                {% if trait.all_normal(method_name) %}
                ARC_SIGNATURE_METHOD({{ method_name }})
                {% else %}
                ARC_AS_FUNCTOR_METHOD({{ method_name }})
                {% for method in trait.methods if method.name == method_name %}
                {{ method_template_params(trait, method) }}
                ARC_INLINE constexpr decltype(auto) {{ method.name }}(this Self{{ " const&" if method.is_const else "&" }} self
                    {%- for type, name in method.params -%}
                    , {{ type }}{{ type.pack }} {{ name }}
                    {%- endfor -%}
                )
                    requires ::arc::CanInvokeMethod<Self, ARC_This_Trait::{{ method_name }}
                        {%- for type, name in method.params -%}
                        , decltype({{ name }}){{ type.pack }}
                        {%- endfor -%}
                    >
                {
                    ARC_SIGNATURE_METHOD_BODY({{ method_name }}
                        {%- for type, name in method.params -%}
                        , ARC_FWD({{ name }}){{ type.pack }}
                        {%- endfor -%}
                    )
                }
                {% endfor %}
                {% endif %}
                {% endfor %}
            };
        };
        using Methods = NamedMethods::{{ trait.name }};
        // Provides interface without any signature enforcement (used when transforming traits with keys)
        struct NamedDuckMethods
        {
            struct {{ trait.name }} : ::arc::MethodsBase
            {
                {% for method_name in trait.method_names %}
                ARC_DUCK_METHOD({{ method_name }})
                {% endfor %}
            };
        };
        using DuckMethods = NamedDuckMethods::{{ trait.name }};
        // Disable redirections `node.impl({{ trait.name }}::method, ...)` --> `node.method(...)`
        struct DisableImpl
        {
            {% for method_name in trait.method_names %}
            ARC_NAMED_METHOD_IMPL_DISABLE({{ method_name }})
            {% endfor %}
        };
        struct NoDisable{};
        // Default method implementations as specified in the trait definition
        struct DefaultImpl
        {
            {% for method in trait.methods if method.default_impl is not none %}
            template<class Self
                {%- if trait.types_name -%}
                , class {{ trait.types_name }} = std::remove_cvref_t<Self>::Types
                {%- endif -%}
                {%- if trait.root_name -%}
                , class {{ trait.root_name }} = ::arc::ResolveRoot<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- if trait.info_name -%}
                , class {{ trait.info_name }} = ::arc::ResolveInfo<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- if trait.impl_named -%}
                , class {{ trait.impl_name }} = ::arc::ContextToNode<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- for prefix, name in method.templates -%}
                , {{ prefix }}{{ prefix.pack }} {{ name }}
                {%- endfor -%}
            >
            ARC_INLINE static constexpr decltype(auto) defaultImpl([[maybe_unused]] Self{{ " const" if method.is_const else "" }}& self, ARC_This_Trait::{{ method.name }}
                {%- for type, name in method.params -%}
                , [[maybe_unused]] {{ type }}{{ type.pack }} {{ name }}
                {%- endfor -%}
            )
            {
                ARC_IF_GCC(::arc::ignoreArgs(self
