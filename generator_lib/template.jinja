{% for trait in namespace.traits %}

{{ export }}{{ trait.wrapping_namespace }} {
{% if trait.templates %}
{{ template(trait.templates) }}
struct {{ trait.name }};
{% else %}
struct {{ trait.name }};
{% endif %}
} // {{ trait.wrapping_namespace }}
{% endfor %}

} // namespace {{ namespace.name }}
{% endfor %}
{% for namespace in repr.namespaces %}

namespace {{ namespace.name }} {
{% for policy in namespace.policies %}

namespace policy {
{{ export }}struct {{ policy.name }}
{
    {% for classification in policy.groups %}
    struct {{ classification.name }};
    {% endfor %}
