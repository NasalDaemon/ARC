{% for policy in namespace.policies %}
{% for classification in policy.groups %}

struct policy::{{ policy.name }}::{{ classification.name }} : ::arc::Group
{
    using ::arc::Group::connectionsTo;
    using ::arc::Group::connectionsFrom;

    {% for toName, write in classification.connectionsTo %}
    static auto connectionsTo({{ toName }} const*) -> {{ "::arc::GroupWriteAccess" if write else "void" }};
    {% endfor %}
    {% for fromName, write in classification.connectionsFrom %}
    static auto connectionsFrom({{ fromName }} const*) -> {{ "::arc::GroupWriteAccess" if write else "void" }};
    {% endfor %}
};
{% endfor %}
{% endfor %}
{% for trait in namespace.traits %}

{{ export }}inline namespace trait {
{% if trait.templates %}
{{ template(trait.templates) }}
struct {{ trait.name }};
{% else %}
struct {{ trait.name }};
{% endif %}
} // inline namespace trait
{% endfor %}
{% for trait in namespace.traits %}

{{ export }}inline namespace trait {
{% if trait.templates %}
{{ template(trait.templates) }}
{% endif %}
struct {{ trait.name }} : ::arc::Trait
{
    {% for method_name in trait.method_names %}
    ARC_METHOD_TAG({{ method_name }})
    {% endfor %}

    template<::arc::IsMethodOf<{{ trait.name }}> Tag>
    friend constexpr {{ trait.name }} traitOf(Tag) { return {}; }

    struct Meta
    {
        using ARC_This_Trait = {{ trait.name }};
        // List of method tags
        struct MethodTags
        {
            {% for method_name in trait.method_names %}
            ARC_METHOD_TAG_ALIAS({{ method_name }})
            {% endfor %}
        };
        // Queryable list of methods applicable to this trait
        struct Applicable
        {
            {% for method_name in trait.method_names %}
            ARC_METHOD_TAG_APPLICABLE({{ method_name }})
            {% endfor %}
        };
        // Contracts and return type constraints of method signatures
        struct Constraints
        {
            {% for method in trait.methods %}
            {% if method.pre_exprs or method.post_exprs or (method.return_type.is_auto and method.return_type.str != "decltype(auto)") %}
            struct {{ capitalise(method.name) }}{{ loop.index }} : ::arc::NoConstraints
            {
                {% if method.return_type.is_auto and method.return_type.str != "decltype(auto)" %}
                template<class T, class {{ trait.types_name or "" }}>
                static consteval {{ method.return_type.str }} Return() { return ARC_DECLVAL(T); }
                static constexpr bool DecltypeAuto = {{ cppbool(method.return_type.str.endswith("decltype(auto)")) }};
                {% endif %}
                {% if method.pre_exprs %}
                static constexpr void pre(auto& _arc_contract_assert_, auto const& self
                    {%- for type, name in method.params -%}
                    , [[maybe_unused]] auto const&{{ type.pack }} {{ name }}
                    {%- endfor -%}
                )
                {
                    ARC_IF_GCC(::arc::ignoreArgs(
                    {%- set comma = joiner(", ") -%}
                    {%- for type, name in method.params -%}
                    {{ comma() }}{{ name }}
                    {%- endfor -%}
                    ));
                    {% for pos, pre in method.pre_exprs %}
                    _arc_contract_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ pre }}));
                    {% endfor %}
                }
                {% endif %}
                {% if method.post_exprs %}
                static constexpr void post(auto& _arc_contract_assert_, auto const& self, auto const& _arc_post_return_contract_value_)
                {
                    {% for pos, name, expr in method.post_exprs %}
                    {
                        auto const& {{ name }} = _arc_post_return_contract_value_;
                        _arc_contract_assert_(self, ARC_ASSERT_ARGS("{{ pos }}", {{ expr }}));
                    }
                    {% endfor %}
                }
                {% endif %}
            };
            {% else %}
            using {{ capitalise(method.name) }}{{ loop.index }} = ::arc::NoConstraints;
            {% endif %}
            {% endfor %}
        };
        // Method signatures generated for this trait
        struct Signatures
        {
            {% for method in trait.methods %}
            template<class Self
                {%- if trait.types_name -%}
                , class {{ trait.types_name }} = std::remove_cvref_t<Self>::Types
                {%- endif -%}
                {%- if trait.root_name -%}
                , class {{ trait.root_name }} = ::arc::ResolveRoot<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- if trait.info_name -%}
                , class {{ trait.info_name }} = ::arc::ResolveInfo<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- if trait.impl_named -%}
                , class {{ trait.impl_name }} = ::arc::ContextToNode<::arc::ContextOf<std::remove_cvref_t<Self>>>
                {%- endif -%}
                {%- for prefix, name in method.templates -%}
                , {{ prefix }}{{ prefix.pack }} {{ name }}
                {%- endfor -%}
            >
            static auto {{ method.name }}(Self{{ " const&" if method.is_const else "&" }}
                {%- for type, name in method.params -%}
                , {{ type }}{{ type.pack }} {{ name }}
                {%- endfor -%}
            )
            {% if method.return_type.is_auto %}
            {% if method.return_type.str == "decltype(auto)" %}
                -> ::arc::InvokeMethod<{{ cppbool(method.is_const) }}, typename Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}{{ argdecltypes(method) }}>;
            {% else %}
                -> ::arc::InvokeMethodC<{{ cppbool(method.is_const) }}, typename Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}{{ argdecltypes(method) }}>;
            {% endif %}
            {% else %}
                -> ::arc::InvokeMethodR<{{ cppbool(method.is_const) }}, typename Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}, ARC_TYPENAME({{ method.return_type.str }}){{ argdecltypes(method) }}>;
            {% endif %}
            {% endfor %}
        };
        // Query method signature by tag `SignaturesByTag::impl(method, ...)` --> `Signatures::method(...)`
        struct SignaturesByTag
        {
            {% for method_name in trait.method_names %}
            ARC_SIGNATURE_METHOD_TAG({{ method_name }})
            {% endfor %}
        };
        // Provides interface to TraitView, enforcing Meta::Signatures and Meta::Constraints
        struct Methods
        {
            {% for method_name in trait.method_names %}
            ARC_SIGNATURE_METHOD({{ method_name }})
            {% endfor %}
        };
        // Provides interface without any signature enforcement (used when transforming traits with keys)
        struct DuckMethods
        {
            {% for method_name in trait.method_names %}
            ARC_DUCK_METHOD({{ method_name }})
            {% endfor %}
        };
        // Disable redirections `node.impl({{ trait.name }}::method, ...)` --> `node.method(...)`
        struct DisableImpl
        {
            {% for method_name in trait.method_names %}
            ARC_NAMED_METHOD_IMPL_DISABLE({{ method_name }})
            {% endfor %}
        };
        // Redirects `node.impl({{ trait.name }}::method, ...)` --> `node.method(...)`
        // Effective only when using arc::NodeImpl<{{ trait.name }}> or arc::Node::Uses<...>::Impl<{{ trait.name }}>
        struct Impl : protected DisableImpl
        {
            struct {{ trait.name }} : MethodTags
            {
                using Disable = DisableImpl;
            };
            {% for method_name in trait.method_names %}
            ARC_NAMED_METHOD_IMPL({{ method_name }})
            {% endfor %}
        };
        // Provides internal node redirection `node.method(...)` --> `node.impl(method, ...)`
        // Effective only when using arc::NodeImpl<{{ trait.name }}*> or arc::Node::Uses<...>::Impl<{{ trait.name }}*>
        struct ImplQualified : Methods
        {
            struct {{ trait.name }} : MethodTags
            {
                using Impl = Methods;
            };
            static void impl() = delete;
        };
        // Provides `node.getSomeTrait()` --> `node.getNode(trait::someTrait)`
        // Effective only when using arc::NodeUses<...> or arc::Node::Uses<...>::Impl<...>
        struct Resolver
        {
            {{ trait_resolver(trait.name) }}
        };
        // Provides `node.getGlobalSomeTrait()` --> `node.getGlobal(trait::someTrait)`
        // Effective only when using arc::NodeUses<...> or arc::Node::Uses<...>::Impl<...>
        struct GlobalResolver
        {
            ARC_GLOBAL_TRAIT_RESOLVER({{ trait.name }})
        };
        // Provides `node.asSomeTrait()` --> `node.asTrait(trait::someTrait)`
        // Effective only when using arc::NodeImpl<...> or arc::Node::Uses<...>::Impl<...>
        struct Converter
        {
            {{ trait_converter(trait.name) }}
        };
    };

    template<class Self, class {{ trait.impl_name }}, class {{ trait.types_name or "" }}
    {%- if trait.root_name -%}
        , class {{ trait.root_name }} = ::arc::ResolveRoot<::arc::ContextOf<{{ trait.impl_name }}>>
    {%- endif -%}
    {%- if trait.info_name -%}
        , class {{ trait.info_name }} = ::arc::ResolveInfo<::arc::ContextOf<{{ trait.impl_name }}>>
    {%- endif -%}
    >
    requires requires ({{ trait.impl_name }} impl_, {{ trait.impl_name }} const const_)
    {
        typename {{ trait.impl_name }}::Traits;
        {% for require in trait.requires %}
        {{ require }}
        {% endfor %}
        {% for method in trait.methods if not method.is_template and not method.optional %}

        {% macro require_invoke() -%}
            {{ "const_" if method.is_const else "impl_" }}.impl({{ method.name }}_c
                {%- for type, name in method.params -%}
                , ARC_FWD({{ name }})
                {%- endfor -%}
            )
        {%- endmacro %}
        {% set comma = joiner(", ") %}
        requires requires (
            {%- for type, name in method.params -%}
            {{ comma() }}{{ type }} {{ name }}
            {%- endfor -%}
            ) {
        {% if method.is_unconstrained_return %}
            {{ require_invoke() }};
        {% elif method.is_auto_return %}
            { {{ require_invoke() }} } -> ::arc::MatchesReturnConstraint<Meta::Constraints::{{ capitalise(method.name) }}{{ loop.index }}, {{ trait.types_name or "void" }}>;
        {% else %}
            { {{ require_invoke() }} } -> std::convertible_to<ARC_TYPENAME({{ method.return_type }})>;
        {% endif %}
        };
        {% endfor %}
    }
    using Implements = void;
};

{% if trait.templates %}
{{ template(trait.templates) }}
inline constexpr {{ trait.name }}<{{ template_params(trait.templates) }}> {{ trait.variable }}{};
{% else %}
inline constexpr {{ trait.name }} {{ trait.variable }}{};
{% endif %}
} // inline namespace trait
{% endfor %}
{% for alias in namespace.trait_aliases %}

{{ export }}inline namespace trait {

{% if alias | count == 2 %}
struct {{ alias[0] }} : ::arc::AltTrait<{{ alias[1] }}, {{ alias[0] }}>
{
    struct Meta : AltTrait::Meta
    {
        struct Impl : AltTrait::Meta::Impl
        {
            struct {{ alias[0] }} : AltTrait::Meta::MethodTags
            {
                using Disable = AltTrait::Meta::DisableImpl;
            };
        };
        struct ImplQualified : AltTrait::Meta::ImplQualified
        {
            struct {{ alias[0] }} : AltTrait::Meta::MethodTags
            {
                using Impl = AltTrait::Meta::ImplQualified;
            };
        };
        struct Resolver
        {
            {{ trait_resolver(alias[0]) }}
        };
        struct GlobalResolver
        {
            ARC_GLOBAL_TRAIT_RESOLVER({{ alias[0] }})
        };
        struct Converter
        {
            {{ trait_converter(alias[0]) }}
        };
    };
};
{% else %}
struct {{ alias[0] }} : ::arc::JoinedTrait<{{ alias[1:] | join(", ") }}>
{
    struct Meta : JoinedTrait::Meta
    {
        struct Impl : JoinedTrait::Meta::Impl
        {
            struct {{ alias[0] }} : JoinedTrait::Meta::MethodTags
            {
                using Disable = JoinedTrait::Meta::DisableImpl;
            };
        };
        struct ImplQualified : JoinedTrait::Meta::ImplQualified
        {
            struct {{ alias[0] }} : JoinedTrait::Meta::MethodTags
            {
                using Impl = JoinedTrait::Meta::ImplQualified;
            };
        };
        struct Resolver : JoinedTrait::Meta::Resolver
        {
            {{ trait_resolver(alias[0]) }}
        };
        struct GlobalResolver : JoinedTrait::Meta::GlobalResolver
        {
            ARC_GLOBAL_TRAIT_RESOLVER({{ alias[0] }})
        };
        struct Converter : JoinedTrait::Meta::Converter
        {
            {{ trait_converter(alias[0]) }}
        };
    };
};
{% endif %}
inline constexpr {{ alias[0] }} {{ decapitalise(alias[0]) }}{};

} // inline namespace trait
{% endfor %}
