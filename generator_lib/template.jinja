{% for namespace in repr.namespaces if namespace.clusters %}

namespace {{ namespace.name }} {
{% for cluster in namespace.clusters %}

{% if cluster.templates %}
{{ template(cluster.templates) }}
template<class {{ cluster.context_name }}>
struct {{ cluster.cluster_class }}::{{ cluster.name }}<{{ template_params(cluster.templates) }}>::Node : {{ cluster.cluster_type }}
{% else %}
template<class {{ cluster.context_name }}>
struct {{ cluster.cluster_class }}::{{ cluster.node_name() }} : {{ cluster.cluster_type }}
{% endif %}
{
    {% if cluster.root_name %}
    using {{ cluster.root_name }} = ::arc::ResolveRoot<{{ cluster.context_name }}>;

    {% endif %}
    {% if cluster.info_name %}
    using {{ cluster.info_name }} = ::arc::ResolveInfo<{{ cluster.context_name }}>;

    {% endif %}
    {% if cluster.aliases %}
    {% for alias, type in cluster.aliases %}
    using {{ alias }} = {{ type }};
    {% endfor %}

    {% endif %}
    using Depends = ::arc::Depends<{{ cluster.dependencies | join(", ") }}>;
    {% if 1 == cluster.nodes | length %}

    static constexpr bool isUnary()
    {
        return decltype({{ cluster.nodes.0.name }})::isUnary();
    }
    {% endif %}

    {% for node in cluster.nodes %}
    struct {{ node.context }};
    {% for alias, target in node.intermediate_aliases %}
    using {{ alias }} = {{ target }};
    {% endfor %}
    using {{ node.node_alias }} = {{ node.impl }};
    {% endfor %}
    {% if cluster.parent_node.connections %}

    {% for connection in cluster.parent_node.connections %}
    {% if connection.is_renaming() %}
    ARC_LINK(({{ connection.trait }}), {{ connection.context }}, ({{ connection.to_trait }}))
    {% else %}
    ARC_LINK(({{ connection.trait }}), {{ connection.context }})
    {% endif %}
    {% endfor %}
    {% endif %}

    {% for node in cluster.nodes %}
    struct {{ node.context }} : ::arc::Context<{{ cluster.node_name() }}, {{ node.context }}Node_>
    {
        {% if node.connected_to_global %}
        ARC_LINK_TO_GLOBAL()
        {% endif %}
        {% for connection in node.connections %}
        {% if connection.is_renaming() %}
        ARC_LINK(({{ connection.trait }}), {{ connection.context }}, ({{ connection.to_trait }}))
        {% else %}
        ARC_LINK(({{ connection.trait }}), {{ connection.context }})
        {% endif %}
        {% endfor %}
    };
    {% endfor %}

    {% for node in cluster.nodes %}
    ARC_NODE({{ node.context }}, {{ node.name }}{{ cluster.predicates_str(node) }})
    {% endfor %}

    constexpr void visit(this auto& self, auto&& visitor)
    {
        {% if 1 == cluster.user_nodes | length %}
        self.{{ cluster.user_nodes.0.name }}.visit(ARC_FWD(visitor));
        {% else %}
        {% for node in cluster.user_nodes %}
        self.{{ node.name }}.visit(visitor);
        {% endfor %}
        {% endif %}
    }
};
{% endfor %}

} // namespace {{ namespace.name }}
{% endfor %}
