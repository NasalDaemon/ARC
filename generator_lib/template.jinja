{%- macro trait_resolver(name) -%}
    {# Ensure to change any clashing getX names to get_X #}
    {%- if name in ("Node", "Global", "State", "Peers", "ElementHandle", "ElementId") -%}
    ARC_TRAIT_RESOLVER(get_{{name}}, {{ name }})
    {%- else -%}
    ARC_TRAIT_RESOLVER({{ name }})
    {%- endif -%}
{%- endmacro -%}

{%- macro trait_converter(name) -%}
    {# Ensure to change any clashing asX names to as_X #}
    {%- if name in ("Trait") -%}
    ARC_TRAIT_CONVERTER(as_{{name}}, {{ name }})
    {%- else -%}
    ARC_TRAIT_CONVERTER({{ name }})
    {%- endif -%}
{%- endmacro -%}

{%- macro capitalise(name) -%}
    {{ name[0].upper() + name[1:] }}
{%- endmacro -%}

{%- macro decapitalise(name) -%}
    {{ name[0].lower() + name[1:] }}
{%- endmacro -%}

{%- macro cppbool(b) -%}
    {{ "true" if b else "false" }}
{%- endmacro -%}

{%- macro argdecltypes(method) -%}
    {%- for type, name in method.params -%}
    , decltype({{ name }}){{ type.pack }}
    {%- endfor -%}
{%- endmacro -%}

{%- macro template(templates) -%}
template<
    {%- set comma = joiner(", ") -%}
    {%- for prefix, name in templates -%}
    {{ comma() }}{{ prefix }}{{ prefix.pack }} {{ name }}
    {%- endfor -%}
>
{%- endmacro -%}

{%- macro template_params(templates) -%}
    {%- set comma = joiner(", ") -%}
    {%- for prefix, name in templates -%}
    {{ comma() }}{{ name }}{{ prefix.pack }}
    {%- endfor -%}
{%- endmacro -%}

