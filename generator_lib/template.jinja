{% macro trait_resolver(name, global) %}
{# Ensure to change any clashing getX names to get_X #}
{% if name in ("Node", "Global", "State", "Peers", "ElementHandle", "ElementId") %}
ARC_TRAIT_RESOLVER(get_{{name}}, {{ "::arc::Global<" + name + ">" if global else name }})
{% elif global %}
ARC_TRAIT_RESOLVER(get{{ name }}, ::arc::Global<{{ name }}>)
{% else %}
ARC_TRAIT_RESOLVER({{ name }})
{% endif %}
{% if global %}
ARC_TRAIT_RESOLVER(getGlobal{{ name }}, ::arc::Global<{{ name }}>)
{% endif %}
{%- endmacro -%}

{%- macro trait_converter(name) -%}
    {# Ensure to change any clashing asX names to as_X #}
    {%- if name in ("Trait") -%}
    ARC_TRAIT_CONVERTER(as_{{name}}, {{ name }})
    {%- else -%}
    ARC_TRAIT_CONVERTER({{ name }})
    {%- endif -%}
{%- endmacro -%}

{%- macro capitalise(name) -%}
    {{ name[0].upper() + name[1:] }}
{%- endmacro -%}

{%- macro decapitalise(name) -%}
    {{ name[0].lower() + name[1:] }}
{%- endmacro -%}

{%- macro cppbool(b) -%}
    {{ "true" if b else "false" }}
{%- endmacro -%}

{%- macro argdecltypes(method) -%}
    {%- for type, name in method.params -%}
    , decltype({{ name }}){{ type.pack }}
    {%- endfor -%}
{%- endmacro -%}

{%- macro template(templates) -%}
template<
    {%- set comma = joiner(", ") -%}
    {%- for prefix, name in templates -%}
    {{ comma() }}{{ prefix }}{{ prefix.pack }} {{ name }}
    {%- endfor -%}
>
{%- endmacro -%}

{%- macro template_params(templates) -%}
    {%- set comma = joiner(", ") -%}
    {%- for prefix, name in templates -%}
    {{ comma() }}{{ name }}{{ prefix.pack }}
    {%- endfor -%}
{%- endmacro -%}

{%- macro method_template_params(trait, method) -%}
template<class Self
    {%- if trait.types_name -%}
    , class {{ trait.types_name }} = std::remove_cvref_t<Self>::Types
    {%- endif -%}
    {%- if trait.root_name -%}
    , class {{ trait.root_name }} = ::arc::ResolveRoot<::arc::ContextOf<std::remove_cvref_t<Self>>>
    {%- endif -%}
    {%- if trait.info_name -%}
    , class {{ trait.info_name }} = ::arc::ResolveInfo<::arc::ContextOf<std::remove_cvref_t<Self>>>
    {%- endif -%}
    {%- if trait.impl_named -%}
    , class {{ trait.impl_name }} = ::arc::ContextToNode<::arc::ContextOf<std::remove_cvref_t<Self>>>
    {%- endif -%}
    {%- for prefix, name in method.templates -%}
    , {{ prefix }}{{ prefix.pack }} {{ name }}
    {%- endfor -%}
>
{%- endmacro -%}

