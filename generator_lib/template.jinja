namespace {{ cluster.cluster_class }} {
{% if not cluster.templates %}
template<class Context>
struct {{ cluster.node_name() }};
{{ export }}using {{ cluster.name }} = ::arc::InlineNode<{{ cluster.node_name() }}>;
{% else %}
{{ export }}{{ template(cluster.templates) }}
struct {{ cluster.name }}
{
    template<class Context>
    struct Node;
};
{% endif %}
